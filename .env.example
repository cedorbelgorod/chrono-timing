# Публичный адрес (для ссылок и QR-кодов)
CHRONO_PUBLIC_URL=https://example.org

# Ключ подписи сессий. Сгенерируйте свой и не коммитьте:
#   python -c "import secrets; print(secrets.token_hex(32))"
CHRONO_SECRET_KEY=

# Логин и пароль администратора по умолчанию
CHRONO_USER=admin
CHRONO_PASS=admin

# Каталог данных (том Docker)
CHRONO_DATA_DIR=./data
